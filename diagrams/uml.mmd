classDiagram
    %% PawPal+ UML. Keep this file updated so it matches the final implementation.

    class Owner {
        +str name
        +int available_minutes
        +str day_start
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +find_pet(name: str) Pet
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task: Task) None
        +find_task(title: str) Task
        +remove_task(title: str) None
        +edit_task(title: str, changes: dict) None
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str preferred_time
        +str start_time
        +str frequency
        +date due_date
        +bool completed
        +date last_completed
        +str pet_name
        +priority_rank() int
        +is_due_today(day: date) bool
        +next_occurrence(day: date) Task
        +mark_complete(day: date) Task
    }

    class Scheduler {
        +Owner owner
        +date date
        +collect_tasks() list~Task~
        +sort_tasks(tasks: list~Task~) list~Task~
        +task_time(task: Task) str
        +sort_by_time(tasks: list~Task~) list~Task~
        +filter_tasks(pet_name: str, completed: bool) list~Task~
        +generate_plan() DailyPlan
        +detect_conflicts(plan: DailyPlan) list~str~
        +mark_task_complete(pet_name: str, title: str) Task
    }

    class DailyPlan {
        +date date
        +list~tuple~ entries
        +list~tuple~ skipped
        +list~str~ warnings
        +add_entry(task: Task, start_time: str, reason: str) None
        +skip(task: Task, reason: str) None
        +total_minutes() int
        +explain() str
    }

    Owner "1" --> "1..*" Pet : has
    Pet "1" *-- "0..*" Task : has
    Scheduler --> Owner : get_all_tasks()
    Scheduler ..> DailyPlan : creates
    DailyPlan --> "0..*" Task : schedules / skips
