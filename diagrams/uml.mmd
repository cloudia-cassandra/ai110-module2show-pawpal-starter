classDiagram
    %% PawPal+ draft UML. Keep this file updated so it matches the final implementation.

    class Owner {
        +str name
        +int available_minutes
        +str day_start
        +list~Pet~ pets
        +add_pet(pet: Pet) None
    }

    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(title: str) None
        +edit_task(title: str, changes: dict) None
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str preferred_time
        +str frequency
        +bool completed
        +date last_completed
        +str pet_name
        +priority_rank() int
        +is_due_today(day: date) bool
        +mark_complete(day: date) None
    }

    class Scheduler {
        +Owner owner
        +date date
        +collect_tasks() list~Task~
        +sort_tasks(tasks: list~Task~) list~Task~
        +generate_plan() DailyPlan
        +detect_conflicts(plan: DailyPlan) list~str~
    }

    class DailyPlan {
        +date date
        +list~tuple~ entries
        +list~tuple~ skipped
        +add_entry(task: Task, start_time: str, reason: str) None
        +skip(task: Task, reason: str) None
        +total_minutes() int
        +explain() str
    }

    Owner "1" --> "1..*" Pet : has
    Pet "1" *-- "0..*" Task : has
    Scheduler --> Owner : reads constraints from
    Scheduler ..> DailyPlan : creates
    DailyPlan --> "0..*" Task : schedules / skips
